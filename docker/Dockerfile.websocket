FROM node:20

WORKDIR /app

RUN npm install -g pnpm@9.0.0

COPY ./packages ./packages
COPY pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY ./package.json ./package.json
COPY apps/ws-backend/package.json ./apps/ws-backend/package.json

COPY ./apps/ws-backend ./apps/ws-backend
RUN pnpm install
RUN pnpm generate:db

RUN pnpm exec turbo build --filter=ws-backend

EXPOSE 8080

CMD ["pnpm", "start:ws"]